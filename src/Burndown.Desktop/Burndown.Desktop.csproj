<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Burndown</AssemblyName>
    <RootNamespace>Burndown.Desktop</RootNamespace>
    <Version>0.8.0</Version>
    <!-- Lets the Linux CI runner compile this project; the app itself runs on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- WPF's Fluent theme (Application.ThemeMode) is still flagged as experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <ApplicationIcon>Assets\burndown.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\burndown.ico" />
  </ItemGroup>

  <!-- `dotnet publish -r win-x64` produces one Burndown.exe (plus Roslyn's BuildHost folders, which MSBuild
       loads by path). It runs on the installed .NET 10 runtime; loading solutions needs the .NET SDK anyway. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <!-- Roslyn starts the BuildHost as its own process from those folders, so its files must stay real files on
       disk; without this, single-file publishing would pack its .dlls into Burndown.exe and loading would fail. -->
  <Target Name="KeepBuildHostOutOfSingleFile" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)"
                             Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('BuildHost-'))"
                             ExcludeFromSingleFile="true" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Burndown.Analysis\Burndown.Analysis.csproj" />
    <ProjectReference Include="..\Burndown.Core\Burndown.Core.csproj" />
    <ProjectReference Include="..\Burndown.Report\Burndown.Report.csproj" />
    <ProjectReference Include="..\Burndown.Repos\Burndown.Repos.csproj" />
  </ItemGroup>

</Project>
