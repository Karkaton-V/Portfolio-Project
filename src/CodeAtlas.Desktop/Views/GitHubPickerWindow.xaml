<Window x:Class="CodeAtlas.Desktop.Views.GitHubPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CodeAtlas.Desktop.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:GitHubPickerViewModel}"
        Title="Add from GitHub"
        Width="820" Height="600" MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="/Assets/codeatlas.ico">

    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Add a repository from GitHub" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Account}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
            <Grid Margin="0,16,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search by name or description" />
                <!-- Placeholder text: WPF's TextBox has none built in. -->
                <TextBlock Text="Search your repositories…" IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <CheckBox Grid.Column="1" Content="C# only" IsChecked="{Binding CSharpOnly}" Margin="16,0,0,0"
                          VerticalAlignment="Center" />
            </Grid>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,14"
                       Text="Repositories already on this PC (in GitHub Desktop's or Visual Studio's folders) are used where they are. Others are downloaded and their NuGet packages restored, which runs their build scripts: only add repositories you trust. If one can't be downloaded, it's analyzed on GitHub's servers instead." />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" MinWidth="96" />
                <Button Content="Add repository" Style="{DynamicResource AccentButtonStyle}" IsDefault="True" MinWidth="132"
                        Margin="8,0,0,0" IsEnabled="{Binding CanAdd}" Click="Add_Click" />
            </StackPanel>
        </StackPanel>

        <Grid>
            <ListView ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" MouseDoubleClick="List_DoubleClick">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Repository" Width="300">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:GitHubRepoItem}">
                                    <StackPanel Margin="0,4">
                                        <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryText}" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Language" Width="100" DisplayMemberBinding="{Binding Language}" />
                        <GridViewColumn Header="Visibility" Width="90" DisplayMemberBinding="{Binding Visibility}" />
                        <GridViewColumn Header="Updated" Width="110" DisplayMemberBinding="{Binding Updated}" />
                        <GridViewColumn Header="" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:GitHubRepoItem}">
                                    <TextBlock Text="{Binding Status}" ToolTip="{Binding StatusTip}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- Loading, not signed in, errors, and empty results -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
                <ProgressBar IsIndeterminate="True" Height="4" Width="220" Margin="0,0,0,16"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding Message}" TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
